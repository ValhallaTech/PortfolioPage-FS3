{
  "name": "portfoliopage-fs3",
  "version": "2.0.0",
  "description": "Fred Smith III Portfolio Page",
  "private": true,
  "source": "src/index.html",
  "scripts": {
    "start": "parcel src/index.html",
    "build": "parcel build src/index.html --public-url ./",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci",
    "lint": "eslint src/js __tests__ tests scripts",
    "lint:fix": "eslint src/js __tests__ tests scripts --fix",
    "format": "prettier --write src/js src/css __tests__ tests scripts",
    "format:check": "prettier --check src/js src/css __tests__ tests scripts",
    "gate": "node scripts/gate.mjs",
    "gate:linux": "node scripts/gate-linux.mjs",
    "verify:release": "jest -c jest.release.config.js",
    "test:smoke": "playwright test --grep-invert @slow",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:live": "BASE_URL=https://fs3portfolio.netlify.app playwright test --grep @live"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.9",
    "glightbox": "3.3.1",
    "isotope-layout": "3.0.6",
    "scrollreveal": "4.0.9",
    "swiper": "14.3.0",
    "typed.js": "3.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@eslint/js": "10.0.1",
    "@parcel/transformer-css": "2.16.4",
    "@playwright/test": "1.65.1",
    "babel-jest": "30.5.2",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.5.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "parcel": "2.16.4",
    "postcss": "8.5.33",
    "prettier": "3.8.3",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "packageManager": "yarn@4.18.1"
}
