{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": { "enabled": true },
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge paused 2026-11-16: GitHub Actions is billing-locked and main has no required checks. Turn it back on only once CI runs again.",
      "groupName": "all dependencies",
      "automerge": false,
      "automergeType": "pr",
      "matchPackageNames": ["*"]
    }
  ],
  "enabledManagers": ["npm", "github-actions"],
  "rangeStrategy": "update-lockfile"
}
